{% set company = guest.system_company %}
{% set support_url = client ? 'support'|url : (guest.support_guest_tickets_enabled() ? 'support/contact-us'|url : 'login'|url) %}
{% set current_active_menu = 'order' %}
<div class="tb-portal">
    {{ include('partial_tb_sidebar.html.twig') }}
    <div class="tb-main">
        <div class="tb-crumb">首页 / 选购</div>
        {% if request.product %}
            <p><a href="{{ 'order'|url }}">返回产品</a></p>
            <div class="tb-order-body">
                <div>
                    {{ include('mod_orderbutton_product_configuration.html.twig') }}
                    {% if not client %}
                        {{ include('mod_orderbutton_client.html.twig') }}
                    {% endif %}
                    {{ include('mod_orderbutton_checkout.html.twig') }}
                </div>
            </div>
        {% else %}
            {{ include('mod_orderbutton_choose_product.html.twig') }}
        {% endif %}
        {% if guest.extension_is_on({"mod":'branding'}) %}
            <div class="d-flex justify-content-center small text-muted pt-3 pb-2">
                {% if 'Powered by :link'|trans != 'Powered by :link' %}
                    {% set fb_link %}<a href="https://fossbilling.org" title="{{ 'Billing Software'|trans }}" target="_blank">FOSSBilling</a>{% endset %}
                    <span>{{ 'Powered by :link'|trans({':link': fb_link})|raw }}</span>
                {% else %}
                    <span>{{ 'Powered by'|trans }}</span>&nbsp;<a href="https://fossbilling.org" title="Billing Software" target="_blank">FOSSBilling</a>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>
