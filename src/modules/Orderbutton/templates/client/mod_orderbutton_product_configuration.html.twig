{% if product is not defined or not product %}
    {% set product = request.product ? guest.product_get({"id":request.product}) : null %}
{% endif %}
<div class="accordion-item">
    <h3 class="accordion-header">
        <button class="accordion-button {% if not product %}collapsed{%endif%}" type="button" data-bs-toggle="collapse" data-bs-target="#order" aria-expanded="true" aria-controls="order">
            <svg class="icon me-2"><use href="#settings" /></svg>
            {{ 'Product Configuration'|trans }}
        </button>
    </h3>
    {% if product %}
    <div id="order" class="accordion-collapse collapse {% if product %}show{%endif%}" data-bs-parent="#orderManager">
        <div class="accordion-body">
            <div class="accordion-inner">
                <form method="post" action="{{ 'cart/add_item'|api_url(role: 'guest') }}" style="background:none;" class="form-{{ product.form_id ? guest.formbuilder_get( {"id":product.form_id}).style.type : 0 }}"
                    {{ fb_api_form({message: 'Product Added to Shopping Cart'|trans, redirect: ('order'|url(query: { 'checkout' : 1 }) ~ (request.show_custom_form_values ? '&show_custom_form_values=1' : ''))}) }}>
                    {% set product_details %}
                        <div class="well">
                            <h3>{{ product.title }}</h3>
                            {% if product.description %}
                                {{ (product.description ?? '')|markdown_to_html }}
                            {% endif %}

                            {% if product.pricing.type is defined %}
                                <hr>

                                <h4 class="mt-4 mb-1"><strong>{{ 'Billing'|trans }}</strong></h4>

                                <div class="row">
                                    <div class="col-12 col-md-4 col-xl-3">
                                        {% if product.pricing.type == 'recurrent' %}
                                        <span>{{ 'Billing Cycle'|trans }}</span>
                                        {% else %}
                                        <span>{{ 'One-time payment'|trans }}</span>
                                        {% endif %}
                                    </div>
                                    <div class="col">
                                        {% set cart_currency = guest.cart_get_currency %}
                                        {% if product.pricing.type == 'recurrent' %}
                                        {% set periods = guest.system_periods %}
                                        <select class="form-select" name="period" id="period-selector">
                                            {% for code,prices in product.pricing.recurrent %}
                                                {% if prices.enabled %}
                                                    <option value="{{ code }}"{% if request.period == code %} selected="selected"{% endif %}>{{ (prices.price * cart_currency.conversion_rate)|format_currency(cart_currency.code) }} ({{ periods[code] }})</option>
                                                {% endif %}
                                            {% endfor %}
                                        </select>
                                        {% elseif product.pricing.type == 'free' %}
                                        <span class="badge text-bg-success">{{ 0|format_currency(cart_currency.code) }}</span>
                                        {% else %}
                                        <span class="badge text-bg-success">{{ (product.pricing.once.price * cart_currency.conversion_rate)|format_currency(cart_currency.code) }}</span>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endif %}
                            {% if product.allow_quantity_select %}
                            <div class="row mt-3">
                                <div class="col-12 col-md-4 col-xl-3">
                                    <span>{{ 'Quantity'|trans }}</span>
                                </div>
                                <div class="col">
                                    <input
                                        type="number"
                                        name="quantity"
                                        value="1"
                                        min="1"
                                        {% if product.stock_control %}max="{{ product.quantity_in_stock }}"{% endif %}
                                        class="form-control w-50"
                                        style="max-width: 120px; text-align: center;"
                                    >
                                </div>
                            </div>
                            {% endif %}
                        </div>
                    {% endset %}

                    {% set tpl = "mod_service"~product.type~"_order_form.html.twig" %}
                    {% if guest.system_template_exists({"file":tpl}) %}
                        {{ include(tpl, product) }}
                    {% elseif product.form_id and guest.extension_is_on({"mod":"formbuilder"}) %}
                        {{ product_details }}
                        {% set form = guest.formbuilder_get({"id":product.form_id}) %}
                        {{ include('mod_formbuilder_build.html.twig', product) }}
                    {% else %}
                        {{ product_details }}
                    {% endif %}

                    {% set cart_currency = guest.cart_get_currency %}
                    {% if product.priced_options is defined and product.priced_options.groups %}
                        <div class="tb-config">
                        <div id="priced-options" class="tb-config-card" data-product-id="{{ product.id }}" data-currency="USD">
                            <h4 class="mt-0 mb-1"><strong>配置选项</strong></h4>
                            <p class="text-muted small mb-3">价格为美元目录价。合计由服务器计算，开通费只在首次账单收取，续费不含开通费。</p>
                            {% for group in product.priced_options.groups %}
                                <div class="row mt-3">
                                    <div class="col-12 col-md-4 col-xl-3">
                                        <label class="form-label" for="priced-option-{{ group.code }}">{{ group.label }}</label>
                                    </div>
                                    <div class="col">
                                        {% if group.disabled|default(false) %}
                                            <select class="form-select" id="priced-option-{{ group.code }}" disabled>
                                                <option>{{ group.reason|default('暂不可选，不计费') }}</option>
                                            </select>
                                        {% else %}
                                        <select class="form-select priced-option-select" name="options[{{ group.code }}]" id="priced-option-{{ group.code }}" data-group="{{ group.code }}">
                                            {% for value in group.values %}
                                                <option value="{{ value.code }}"{% if value.is_default %} selected{% endif %}{% if not value.in_stock %} disabled{% endif %}>
                                                    {{- value.label -}}
                                                    {%- if value.monthly_amount != '0.00' %}（每月 +US${{ value.monthly_amount }}）{% endif -%}
                                                    {%- if value.setup_amount != '0.00' %}（开通费 +US${{ value.setup_amount }}）{% endif -%}
                                                    {%- if not value.in_stock %}（无库存）{% endif -%}
                                                </option>
                                            {% endfor %}
                                        </select>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                            <p class="text-muted small mt-3 mb-0">部分机型不提供 Windows。Windows 暂不可选、不计费。快照和备份暂不可选、不计费。</p>
                        </div>
                        <aside id="priced-option-quote" class="tb-summary" role="status">正在计算价格…</aside>
                        </div>
                        <div class="tb-bar" id="priced-option-bar">正在计算价格…</div>
                    {% elseif product.slug starts with 'mc-' %}
                        <div class="alert alert-secondary mt-3 mb-0" role="status">可选配置暂未开放。未公布的项目不会以 0 元出售。</div>
                    {% endif %}

                    {{ include('mod_orderbutton_addons.html.twig', product) }}

                    <input type="hidden" name="multiple" value="1" />
                    <input type="hidden" name="id" value="{{ product.id }}" />
                    <div class="mt-2 mb-0">
                        {% if product.slug starts with 'mc-' or (product.orderable is defined and not product.orderable) %}
                        <div class="alert alert-secondary mb-0" role="status">待资源就绪，暂不可订购。本站暂无可履约的对应资源，开放前不接受下单。</div>
                        {% else %}
                        <button type="submit" class="btn btn-primary" id="config-next">{{ 'Next'|trans }}</button>
                        {% endif %}
                    </div>
                    {% if product.priced_options is defined and product.priced_options.groups %}
                    <script>
                        document.addEventListener('DOMContentLoaded', function () {
                            const root = document.getElementById('priced-options');
                            const output = document.getElementById('priced-option-quote');
                            const bar = document.getElementById('priced-option-bar');
                            if (!root || !output || typeof FOSSBilling === 'undefined') {
                                return;
                            }
                            const productId = Number(root.dataset.productId);
                            const currency = root.dataset.currency;
                            const esc = function (value) {
                                return String(value ?? '').replace(/[&<>"']/g, function (ch) {
                                    return {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[ch];
                                });
                            };
                            const refresh = function () {
                                const options = {};
                                root.querySelectorAll('.priced-option-select').forEach(function (select) {
                                    options[select.dataset.group] = select.value;
                                });
                                const period = document.getElementById('period-selector');
                                FOSSBilling.api.guest.post('product/priced_options_quote', {
                                    id: productId,
                                    currency: currency,
                                    period: period ? period.value : '1M',
                                    options: options
                                }, function (result) {
                                    const rows = (result.lines || []).map(function (line) {
                                        const kind = line.billing === 'setup' ? '一次性开通费' : '周期费用';
                                        return '<div class="d-flex justify-content-between"><span>' + esc(line.label) + '</span><span>' + esc(line.amount) + ' ' + esc(result.currency) + '（' + kind + '）</span></div>';
                                    }).join('');
                                    output.innerHTML = rows
                                        + '<hr class="my-2">'
                                        + '<div class="d-flex justify-content-between"><strong>周期费用合计</strong><strong>' + esc(result.recurring) + ' ' + esc(result.currency) + '</strong></div>'
                                        + '<div class="d-flex justify-content-between"><strong>一次性开通费</strong><strong>' + esc(result.setup) + ' ' + esc(result.currency) + '</strong></div>'
                                        + '<div class="d-flex justify-content-between"><strong>本期应付</strong><strong>' + esc(result.due_now) + ' ' + esc(result.currency) + '</strong></div>'
                                        + (result.purchasable ? '' : '<div class="mt-2">待资源就绪，暂不可订购。可以预览价格，不能加入购物车。</div>');
                                    if (bar) {
                                        bar.textContent = '周期费用 ' + result.recurring + ' ' + result.currency
                                            + ' · 开通费 ' + result.setup + ' ' + result.currency
                                            + ' · 本期应付 ' + result.due_now + ' ' + result.currency;
                                    }
                                }, function (error) {
                                    const message = error && error.message ? error.message : '价格计算失败';
                                    output.textContent = message;
                                    if (bar) {
                                        bar.textContent = message;
                                    }
                                });
                            };
                            root.querySelectorAll('.priced-option-select').forEach(function (select) {
                                select.addEventListener('change', refresh);
                            });
                            const period = document.getElementById('period-selector');
                            if (period) {
                                period.addEventListener('change', refresh);
                            }
                            refresh();
                        });
                    </script>
                    {% endif %}
                </form>
            </div>
        </div>
    </div>
    {% endif %}
</div>
