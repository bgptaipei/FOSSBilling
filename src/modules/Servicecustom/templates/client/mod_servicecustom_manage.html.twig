{% set vm = client.servicecustom_call({ 'order_id': order.id, 'method': 'info' }) %}
{% if order.config.priced_option_summary is defined and order.config.priced_option_summary %}
<div class="card mb-4">
  <div class="card-header"><h5 class="mb-0">订购配置</h5></div>
  <div class="card-body"><pre class="mb-0" style="white-space: pre-line">{{ order.config.priced_option_summary }}</pre></div>
</div>
{% endif %}
<div class="card mb-4">
  <div class="card-header"><h5 class="mb-0">云服务器</h5></div>
  <div class="card-body">
  {% if not vm.provisioned %}
    <div class="alert alert-info mb-0">正在开通中，请稍后刷新。</div>
  {% else %}
    <table class="table table-sm">
      <tr><td>状态</td><td><strong>{% set vm_states = {'INIT':'初始化中（INIT）','PENDING':'排队中（PENDING）','HOLD':'已挂起（HOLD）','PROLOG':'准备中（PROLOG）','BOOT':'启动中（BOOT）','MIGRATE':'迁移中（MIGRATE）','EPILOG':'清理中（EPILOG）','SHUTDOWN':'关机中（SHUTDOWN）','SHUTDOWN_POWEROFF':'关机中（SHUTDOWN_POWEROFF）','STOPPED':'已停止（STOPPED）','SUSPENDED':'已暂停（SUSPENDED）','UNDEPLOYED':'已卸载（UNDEPLOYED）','FAILED':'失败（FAILED）','BOOT_FAILURE':'启动失败（BOOT_FAILURE）','DONE':'已删除（DONE）','HOTPLUG':'热插拔中（HOTPLUG）','UNKNOWN':'未知（UNKNOWN）','CLONING':'克隆中（CLONING）','CLONING_FAILURE':'克隆失败（CLONING_FAILURE）'} %}{% if vm.state == 'RUNNING' %}运行中{% elseif vm.state == 'POWEROFF' %}已关机{% elseif vm.state starts with 'ERROR: ' %}错误：{{ vm.state|slice(7) }}{% else %}{{ vm_states[vm.state]|default(vm.state) }}{% endif %}</strong></td></tr>
      <tr><td>公网 IP</td><td>{{ vm.ip }}</td></tr>
      <tr><td>SSH</td><td>{{ vm.ip }}:{{ vm.ssh_port }}</td></tr>
      <tr><td>账号</td><td>{{ vm.username }}</td></tr>
      <tr><td>初始密码</td><td><code>{{ vm.password }}</code> <small class="text-muted">（首次登录后请自行修改）</small></td></tr>
      <tr><td>配置</td><td>{{ vm.vcpu }} 核 / {{ vm.memory }} MB / {{ vm.disk }} GB</td></tr>
    </table>
    <div class="d-flex flex-wrap gap-2">
      {% for m, label in {'start':'开机','stop':'关机','reboot':'重启','hardreboot':'强制重启','reinstall':'重装系统（清空数据）'} %}
      <form method="post" action="{{ 'servicecustom/call'|api_url }}" {{ fb_api_form({ 'reload': true, 'message': label ~ ' 指令已发送' }) }}>
        <input type="hidden" name="order_id" value="{{ order.id }}">
        <input type="hidden" name="method" value="{{ m }}">
        <button class="btn btn-{% if m == 'reinstall' %}danger{% else %}primary{% endif %} btn-sm" type="submit" {% if m == 'reinstall' %}onclick="return confirm('确认重装？数据将被清空')"{% endif %}>{{ label }}</button>
      </form>
      {% endfor %}
    </div>
  {% endif %}
  </div>
</div>
